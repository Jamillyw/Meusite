      }
    };

    function setView(viewName) {
      if (activeSession && viewName !== "session") {
        showToast(
          "Finalize o treino atual ou encerre a sessão antes de sair."
        );
        return;
      }

      currentView = viewName;

      document.querySelectorAll(".view").forEach(view => {
        view.hidden = view.id !== "view-" + viewName;
      });

      document.querySelectorAll(".nav-btn").forEach(button => {
        button.classList.toggle(
          "active",
          button.dataset.view === viewName
        );
      });

      const info = viewInfo[viewName];

      $("#pageTitle").textContent = info.title;
      $("#pageSubtitle").textContent = info.subtitle;

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    document.querySelectorAll("[data-view]").forEach(button => {
      button.addEventListener("click", () => {
        setView(button.dataset.view);
      });
    });

    document.querySelectorAll("[data-go]").forEach(button => {
      button.addEventListener("click", () => {
        setView(button.dataset.go);
      });
    });

    $("#heroStart").addEventListener("click", () => {
      setView("workouts");
    });

    /* =========================================
       5. CARTÕES DOS TREINOS
    ========================================= */

    function makeWorkoutCard(workout) {
      const preview = workout.exercises
        .slice(0, 3)
        .map(exercise =>
          `<li>${escapeHTML(exercise.name)}</li>`
        )
        .join("");

      return `
        <article class="workout-card">
          <div class="workout-card-top">
            <div class="workout-code">CORPO INTEIRO · FICHA ${workout.id}</div>
            <h3>${escapeHTML(workout.name)}</h3>
            <p>${escapeHTML(workout.title)}</p>
          </div>

          <div class="workout-card-body">
            <div class="workout-info">
              <span>6 exercícios</span>
              <span>2 séries cada</span>
            </div>

            <p class="panel-description">
              ${escapeHTML(workout.description)}
            </p>

            <ul class="exercise-preview">
              ${preview}
            </ul>

            <button
              class="btn btn-primary btn-full"
              data-start-workout="${workout.id}"
            >
              ▶ &nbsp; Iniciar treino
            </button>
          </div>
        </article>
      `;
    }

    function renderWorkoutCards() {
      $("#overviewWorkoutCards").innerHTML =
        workouts.map(makeWorkoutCard).join("");

      $("#allWorkoutCards").innerHTML =
        workouts.map(makeWorkoutCard).join("");

      document.querySelectorAll("[data-start-workout]").forEach(button => {
        button.addEventListener("click", () => {
          startWorkout(button.dataset.startWorkout);
        });
      });
    }

    /* =========================================
       6. ESTATÍSTICAS E HISTÓRICO
    ========================================= */

    function countRecentDays(days) {
      const cutoff = Date.now() - days * 24 * 60 * 60 * 1000;

      return history.filter(item => {
        const date = new Date(item.date).getTime();

        return Number.isFinite(date) && date >= cutoff;
      }).length;
    }

    function renderStats() {
      $("#statWeek").textContent = countRecentDays(7);
      $("#statTotal").textContent = history.length;
    }

    function renderHistory() {
      const container = $("#historyList");

      if (history.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <div style="font-size:24px; margin-bottom:10px;">◈</div>
            Nenhum treino registrado ainda.<br>
            Quando concluir uma sessão, ela aparecerá aqui.
          </div>
        `;

        return;
      }

      container.innerHTML = history
        .slice(0, 30)
        .map(item => `
          <div class="history-item">
            <div>
              <div class="history-name">
                ${escapeHTML(item.name)}
              </div>

              <div class="history-date">
                ${escapeHTML(formatDate(item.date))}
                · ${Number(item.exerciseCount) || 6} exercícios
              </div>
            </div>

            <span class="history-status">✓ Concluído</span>
          </div>
        `)
        .join("");
    }

    /* =========================================
       7. CONFIGURAÇÕES DE PROGRESSÃO
    ========================================= */

    function renderSettings() {
      $("#repBoost").value = String(settings.repBoost);
      $("#restSeconds").value = String(settings.restSeconds);
    }

    function saveSettings() {
      writeStorage(STORAGE.settings, settings);
      renderSettings();
      showToast("Preferências salvas neste dispositivo.");
    }

    $("#repBoost").addEventListener("change", event => {
      const value = Number(event.target.value);

      settings.repBoost = [0, 1, 2].includes(value) ? value : 0;

      saveSettings();
    });

    $("#restSeconds").addEventListener("change", event => {
      const value = Number(event.target.value);

      settings.restSeconds = ALLOWED_REST.includes(value) ? value : 75;

      saveSettings();
    });

    $("#resetSettings").addEventListener("click", () => {
      settings = { ...DEFAULT_SETTINGS };

      saveSettings();

      showToast("Ajustes iniciais restaurados.");
    });

    /* =========================================
       8. INICIAR UMA SESSÃO
    ========================================= */

    function startWorkout(workoutId) {
      const workout = findWorkout(workoutId);

      if (!workout) {
        showToast("Não foi possível encontrar esse treino.");
        return;
      }

      activeSession = {
        workoutId: workout.id,
        index: 0,
        set: 1,
        completedCount: 0,
        restMode: null,
        restRemaining: 0,
        startedAt: Date.now()
      };

      setView("session");
      renderSession();
    }

    function totalSets(workout) {
      return workout.exercises.reduce(
        (total, exercise) => total + (exercise.sets || 2),
        0
      );
    }

    function renderSetDots(exercise, currentSet) {
      const sets = exercise.sets || 2;

      return Array.from({ length: sets }, (_, index) => {
        let className = "set-dot";

        if (index + 1 < currentSet) {
          className += " done";
        } else if (index + 1 === currentSet) {
          className += " current";
        }

        return `<span class="${className}"></span>`;
      }).join("");
    }

    /* =========================================
       9. MOSTRAR A SESSÃO ATUAL
    ========================================= */

    function renderSession() {
      if (!activeSession) {
        return;
      }

      const workout = findWorkout(activeSession.workoutId);
      const exercise = workout.exercises[activeSession.index];

      const total = totalSets(workout);
      const progress = Math.min(
        100,
        (activeSession.completedCount / total) * 100
      );

      const atRest = activeSession.restMode !== null;

      const header = `
        <div class="session-heading">
          <div>
            <div class="eyebrow">
              FICHA ${workout.id} · ${activeSession.index + 1}
              DE ${workout.exercises.length} EXERCÍCIOS
            </div>

            <h2>${escapeHTML(workout.name)}</h2>

            <div class="page-subtitle">
              ${escapeHTML(workout.title)}
            </div>
          </div>

          <button class="btn btn-secondary btn-small" id="quitWorkout">
            Encerrar
          </button>
        </div>

        <div
          class="progress-track"
          role="progressbar"
          aria-label="Progresso do treino"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="${Math.round(progress)}"
        >
          <div class="progress-fill" style="width:${progress}%"></div>
        </div>
      `;

      let content = "";

      if (atRest) {
        const isSetRest = activeSession.restMode === "set";

        const nextDescription = isSetRest
          ? `Próxima: série ${activeSession.set + 1} de ${exercise.sets || 2}.`
          : `Próximo exercício: ${
              workout.exercises[activeSession.index + 1].name
            }.`;

        content = `
          <div class="session-card">
            <div class="timer-wrap">
              <div class="eyebrow">
                ${isSetRest ? "DESCANSO ENTRE SÉRIES" : "DESCANSO"}
              </div>

              <h3>
                Recupere antes de continuar
              </h3>

              <p class="timer-caption">
                Respire com calma e espere estar pronta para
                continuar com boa técnica.
              </p>

              <div class="timer-number" id="timerValue">
                ${formatTime(activeSession.restRemaining)}
              </div>

              <div class="timer-caption">
                ${escapeHTML(nextDescription)}
              </div>

              <div class="session-footer" style="justify-content:center;">
                <button class="btn btn-primary" id="skipRest">
                  Continuar agora
                </button>
              </div>
            </div>
          </div>

          <p class="panel-description">
            Se ainda estiver cansada quando o cronômetro terminar,
            faça uma pausa maior. O relógio não é uma obrigação.
          </p>
        `;
      } else {
        const goal = getGoalLabel(exercise);
        const sets = exercise.sets || 2;

        content = `
          <div class="session-card">
            <div class="eyebrow">
              ${escapeHTML(exercise.focus)}
            </div>

            <h3>${escapeHTML(exercise.name)}</h3>

            <div class="session-goal">
              ${escapeHTML(goal)}
            </div>

            <div class="session-goal-caption">
              Meta desta série · ${sets} séries no total
            </div>

            <div class="set-indicator" aria-label="Séries">
              ${renderSetDots(exercise, activeSession.set)}
            </div>

            <div class="session-instructions">
              <strong>Como fazer</strong><br>
              ${escapeHTML(exercise.instructions)}
            </div>

            <div class="session-instructions">
              <strong>Antes de concluir</strong><br>
              Faça a série com controle e respire normalmente.
              Não precisa chegar à exaustão. Se a técnica se perder,
              pare e adapte o movimento.
            </div>

            <div class="session-footer">
              <button class="btn btn-primary" id="finishSet">
                ✓ &nbsp; Concluí a série
              </button>
            </div>
          </div>
        `;
      }

      $("#sessionContainer").innerHTML = header + content;

      $("#quitWorkout").addEventListener("click", quitWorkout);

      if (atRest) {
        $("#skipRest").addEventListener("click", () => {
          clearInterval(timerInterval);
          timerInterval = null;
          finishRest();
        });
      } else {
        $("#finishSet").addEventListener("click", completeSet);
      }
    }

    /* =========================================
       10. CONCLUIR SÉRIE E CONTAR DESCANSO
    ========================================= */

    function completeSet() {
      if (!activeSession || activeSession.restMode !== null) {
        return;
      }

      const workout = findWorkout(activeSession.workoutId);
      const exercise = workout.exercises[activeSession.index];

      activeSession.completedCount++;

      const sets = exercise.sets || 2;
      const isLastSet = activeSession.set >= sets;
      const isLastExercise =
        activeSession.index >= workout.exercises.length - 1;

      if (isLastSet && isLastExercise) {
        finishWorkout();
        return;
      }

      activeSession.restMode = isLastSet ? "next" : "set";
      activeSession.restRemaining = settings.restSeconds;

      renderSession();
      startRestTimer();
    }

    function startRestTimer() {
      clearInterval(timerInterval);

      timerInterval = setInterval(() => {
        if (!activeSession || activeSession.restMode === null) {
          clearInterval(timerInterval);
          timerInterval = null;
          return;
        }

        activeSession.restRemaining--;

        const timer = $("#timerValue");

        if (timer) {
          timer.textContent = formatTime(activeSession.restRemaining);
        }

        if (activeSession.restRemaining <= 0) {
          clearInterval(timerInterval);
          timerInterval = null;
          finishRest();
        }
      }, 1000);
    }

    function finishRest() {
      if (!activeSession) {
        return;
      }

      const mode = activeSession.restMode;

      activeSession.restMode = null;
      activeSession.restRemaining = 0;

      if (mode === "set") {
        activeSession.set++;
        showToast("Descanso concluído. Próxima série!");
      } else if (mode === "next") {
        activeSession.index++;
        activeSession.set = 1;
        showToast("Vamos ao próximo exercício.");
      }

      renderSession();
    }

    /* =========================================
       11. ENCERRAR OU CONCLUIR O TREINO
    ========================================= */

    function quitWorkout() {
      if (!activeSession) {
        return;
      }

      const confirmed = window.confirm(
        "Deseja encerrar este treino? A sessão incompleta não será " +
        "registrada como treino concluído."
      );

      if (!confirmed) {
        return;
      }

      clearInterval(timerInterval);
      timerInterval = null;
      activeSession = null;

      setView("overview");
      showToast("Sessão encerrada. Você pode voltar quando quiser.");
    }

    function finishWorkout() {
      if (!activeSession) {
        return;
      }

      clearInterval(timerInterval);
      timerInterval = null;

      const workout = findWorkout(activeSession.workoutId);

      const durationMinutes = Math.max(
        1,
        Math.round((Date.now() - activeSession.startedAt) / 60000)
      );

      const record = {
        date: new Date().toISOString(),
        workoutId: workout.id,
        name: workout.name,
        exerciseCount: workout.exercises.length,
        durationMinutes: durationMinutes
      };

      history.unshift(record);
      history = history.slice(0, 200);

      writeStorage(STORAGE.history, history);

      activeSession = null;

      $("#doneDescription").textContent =
        "Você concluiu " + workout.name +
        ". Reconheça seu esforço e recupere-se tranquilamente.";

      $("#doneDetails").textContent =
        workout.exercises.length + " exercícios · " +
        durationMinutes + " min de sessão";

      renderAll();
      setView("complete");
    }

    /* =========================================
       12. INICIALIZAÇÃO
    ========================================= */

    function renderAll() {
      renderWorkoutCards();
      renderStats();
      renderHistory();
      renderSettings();
    }

    function updateDate() {
      $("#todayChip").textContent = new Date().toLocaleDateString(
        "pt-BR",
        {
          weekday: "short",
          day: "2-digit",
          month: "short"
        }
      );
    }

    function init() {
      renderAll();
      updateDate();
      setView("overview");
    }

    init();
  </script>
</body>
</html>
