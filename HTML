<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080b20">

  <title>Treinos & Evolução</title>

  <style>
    /* =========================================
       1. TEMA E ESTILOS GERAIS
    ========================================= */

    :root {
      --bg: #080b1e;
      --panel: #121735;
      --panel-light: #19214a;
      --blue: #405cff;
      --blue-light: #6882ff;
      --purple: #7545e8;
      --text: #f7f8ff;
      --muted: #9ba6d2;
      --border: rgba(157, 174, 255, 0.13);
      --green: #6ce6b0;
      --radius: 22px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(
          circle at 85% 5%,
          rgba(72, 80, 255, 0.18),
          transparent 28%
        ),
        radial-gradient(
          circle at 10% 45%,
          rgba(105, 53, 220, 0.13),
          transparent 28%
        ),
        var(--bg);
      color: var(--text);
      font-family:
        Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    button,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    button:focus-visible,
    select:focus-visible {
      outline: 2px solid var(--blue-light);
      outline-offset: 3px;
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    [hidden] {
      display: none !important;
    }

    .app-shell {
      width: min(1440px, 100%);
      min-height: 100vh;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 235px minmax(0, 1fr);
    }

    /* =========================================
       2. MENU LATERAL
    ========================================= */

    .sidebar {
      padding: 28px 16px;
      border-right: 1px solid var(--border);
      background: rgba(8, 11, 30, 0.73);
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 0 8px;
    }

    .brand-mark {
      width: 43px;
      height: 43px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      font-size: 24px;
      background: linear-gradient(135deg, var(--blue), var(--purple));
      box-shadow: 0 0 28px rgba(75, 91, 255, 0.32);
    }

    .brand-name {
      font-size: 15px;
      font-weight: 850;
      letter-spacing: -0.5px;
    }

    .brand-caption {
      color: var(--muted);
      font-size: 11px;
      margin-top: 3px;
    }

    .nav-label,
    .eyebrow {
      color: #aab6f2;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 800;
    }

    .nav-label {
      padding: 0 12px;
      margin-bottom: 10px;
    }

    .nav-list {
      display: grid;
      gap: 7px;
    }

    .nav-btn {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--muted);
      border-radius: 14px;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: 0.2s ease;
    }

    .nav-btn:hover {
      background: rgba(255, 255, 255, 0.045);
      color: white;
    }

    .nav-btn.active {
      background: linear-gradient(
        110deg,
        rgba(59, 88, 255, 0.25),
        rgba(101, 61, 216, 0.16)
      );
      border-color: rgba(104, 130, 255, 0.2);
      color: white;
    }

    .nav-icon {
      width: 22px;
      text-align: center;
      font-size: 17px;
    }

    .sidebar-note {
      margin-top: auto;
      padding: 18px 15px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: linear-gradient(
        145deg,
        rgba(64, 92, 255, 0.14),
        rgba(117, 69, 232, 0.08)
      );
    }

    .sidebar-note p {
      font-size: 12px;
      line-height: 1.7;
      color: var(--muted);
      margin: 9px 0 0;
    }

    /* =========================================
       3. CONTEÚDO PRINCIPAL
    ========================================= */

    .main {
      min-width: 0;
      padding: 30px clamp(16px, 3vw, 38px) 45px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 27px;
    }

    .page-title {
      margin: 0;
      font-size: clamp(22px, 3vw, 30px);
      letter-spacing: -1px;
    }

    .page-subtitle {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
      margin: 7px 0 0;
    }

    .date-chip {
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.035);
      color: #dce2ff;
      padding: 11px 14px;
      border-radius: 13px;
      font-size: 12px;
      white-space: nowrap;
    }

    .view {
      animation: fadeIn 0.25s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(5px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* =========================================
       4. CARD PRINCIPAL
    ========================================= */

    .hero {
      position: relative;
      overflow: hidden;
      min-height: 245px;
      padding: clamp(24px, 4vw, 42px);
      display: flex;
      align-items: center;
      border: 1px solid rgba(151, 167, 255, 0.25);
      border-radius: 27px;
      background:
        radial-gradient(
          ellipse at 85% 20%,
          rgba(155, 109, 255, 0.55),
          transparent 28%
        ),
        radial-gradient(
          ellipse at 90% 120%,
          rgba(44, 159, 255, 0.4),
          transparent 38%
        ),
        linear-gradient(120deg, #1a38c7, #29267e 58%, #41267d);
      box-shadow: 0 22px 70px rgba(24, 41, 142, 0.15);
    }

    .hero::after {
      content: "";
      position: absolute;
      right: -65px;
      bottom: -150px;
      width: 340px;
      height: 340px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 50%;
      box-shadow:
        0 0 0 35px rgba(255, 255, 255, 0.035),
        0 0 0 70px rgba(255, 255, 255, 0.025);
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 490px;
    }

    .hero .eyebrow {
      color: #d5dcff;
    }

    .hero h2 {
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.12;
      letter-spacing: -1.5px;
      margin: 14px 0 12px;
      max-width: 450px;
    }

    .hero p {
      color: #e1e5ff;
      font-size: 14px;
      line-height: 1.7;
      max-width: 430px;
      margin: 0 0 23px;
    }

    .hero-symbol {
      display: grid;
      place-items: center;
      position: absolute;
      right: 9%;
      top: 21%;
      font-size: clamp(65px, 9vw, 105px);
      color: rgba(255, 255, 255, 0.19);
      transform: rotate(-12deg);
      user-select: none;
    }

    /* =========================================
       5. BOTÕES
    ========================================= */

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 18px;
      border-radius: 13px;
      border: 1px solid transparent;
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
      transition:
        transform 0.18s ease,
        filter 0.18s ease,
        background 0.18s ease;
    }

    .btn:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }

    .btn-primary {
      background: linear-gradient(110deg, #6480ff, #6949ef);
      color: white;
      box-shadow: 0 8px 25px rgba(54, 75, 255, 0.24);
    }

    .btn-white {
      background: white;
      color: #17204c;
    }

    .btn-secondary {
      border-color: var(--border);
      background: rgba(255, 255, 255, 0.045);
      color: #e6eaff;
    }

    .btn-danger {
      color: #ffbecb;
      border-color: rgba(255, 101, 137, 0.23);
      background: rgba(255, 80, 119, 0.08);
    }

    .btn-small {
      padding: 10px 13px;
      font-size: 12px;
    }

    .btn-full {
      width: 100%;
    }

    /* =========================================
       6. ESTATÍSTICAS
    ========================================= */

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin: 21px 0 34px;
    }

    .stat-card {
      padding: 19px;
      min-width: 0;
      border-radius: 19px;
      background: linear-gradient(
        145deg,
        rgba(24, 32, 72, 0.97),
        rgba(17, 22, 50, 0.96)
      );
      border: 1px solid var(--border);
    }

    .stat-heading {
      font-size: 12px;
      color: var(--muted);
    }

    .stat-number {
      font-size: clamp(23px, 3vw, 32px);
      font-weight: 900;
      letter-spacing: -1px;
      margin: 10px 0 5px;
    }

    .stat-help {
      font-size: 11px;
      line-height: 1.5;
      color: #8897c8;
    }

    /* =========================================
       7. SEÇÕES E TREINOS
    ========================================= */

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 15px;
      margin: 30px 0 17px;
    }

    .section-heading h2 {
      font-size: 19px;
      letter-spacing: -0.5px;
      margin: 0;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
      margin: 7px 0 0;
    }

    .text-link {
      border: 0;
      background: transparent;
      color: #9db0ff;
      font-size: 12px;
      font-weight: 800;
      padding: 8px 0;
    }

    .workout-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .workout-card {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 21px;
      background: linear-gradient(
        160deg,
        rgba(26, 35, 82, 0.96),
        rgba(17, 22, 49, 0.97)
      );
    }

    .workout-card-top {
      min-height: 116px;
      padding: 19px;
      position: relative;
      background:
        radial-gradient(
          circle at 90% 15%,
          rgba(255, 255, 255, 0.17),
          transparent 27%
        ),
        linear-gradient(130deg, #253de0, #4730a7);
    }

    .workout-card:nth-child(2) .workout-card-top {
      background: linear-gradient(130deg, #4b45e5, #34267c);
    }

    .workout-card:nth-child(3) .workout-card-top {
      background: linear-gradient(130deg, #176ac5, #2a3199);
    }

    .workout-code {
      color: #e3e7ff;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.4px;
    }

    .workout-card-top h3 {
      font-size: 23px;
      margin: 12px 0 5px;
      letter-spacing: -0.7px;
    }

    .workout-card-top p {
      color: #e5e9ff;
      font-size: 11px;
      margin: 0;
    }

    .workout-card-body {
      padding: 18px;
    }

    .workout-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 13px;
    }

    .exercise-preview {
      list-style: none;
      padding: 0;
      margin: 0 0 19px;
    }

    .exercise-preview li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 8px 0;
      border-bottom: 1px solid rgba(157, 174, 255, 0.08);
      font-size: 11px;
      line-height: 1.5;
      color: #d5dbfa;
    }

    .exercise-preview li::before {
      content: "✦";
      color: #859bff;
    }

    /* =========================================
       8. PAINÉIS AUXILIARES
    ========================================= */

    .content-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.8fr);
      gap: 17px;
      margin-top: 30px;
    }

    .panel {
      min-width: 0;
      padding: 23px;
      border-radius: var(--radius);
      background: linear-gradient(
        145deg,
        rgba(23, 31, 70, 0.96),
        rgba(15, 20, 46, 0.97)
      );
      border: 1px solid var(--border);
    }

    .panel h3 {
      margin: 0;
      font-size: 16px;
    }

    .panel-description {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.75;
      margin: 10px 0 0;
    }

    .schedule-list {
      display: grid;
      gap: 11px;
      margin-top: 19px;
    }

    .schedule-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 13px;
      border-radius: 13px;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(157, 174, 255, 0.07);
    }

    .schedule-day {
      font-size: 12px;
      font-weight: 800;
    }

    .schedule-name {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
    }

    .schedule-badge {
      font-size: 10px;
      color: #c7d0ff;
      background: rgba(88, 106, 255, 0.17);
      padding: 7px 9px;
      border-radius: 9px;
      white-space: nowrap;
    }

    .safety-panel {
      border-color: rgba(108, 230, 176, 0.17);
      background: linear-gradient(
        145deg,
        rgba(25, 61, 66, 0.34),
        rgba(17, 23, 51, 0.96)
      );
    }

    .safety-panel h3 {
      color: #aaf1d0;
    }

    .tip-line {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-top: 15px;
      font-size: 12px;
      line-height: 1.65;
      color: #cbd5ee;
    }

    .tip-icon {
      color: var(--green);
      font-weight: 900;
    }

    /* =========================================
       9. PROGRESSÃO
    ========================================= */

    .settings-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 17px;
      margin-top: 22px;
    }

    .setting-field {
      padding: 19px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.025);
      border-radius: 17px;
    }

    .setting-field label {
      display: block;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 9px;
    }

    .setting-field p {
      margin: 0 0 14px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }

    .setting-field select {
      width: 100%;
      min-height: 45px;
      border: 1px solid rgba(157, 174, 255, 0.2);
      border-radius: 11px;
      padding: 11px;
      background: #111735;
      color: white;
    }

    .notice {
      margin-top: 18px;
      padding: 16px 18px;
      border: 1px solid rgba(255, 209, 116, 0.15);
      background: rgba(255, 197, 88, 0.055);
      color: #e9dcb9;
      font-size: 12px;
      line-height: 1.8;
      border-radius: 15px;
    }

    /* =========================================
       10. HISTÓRICO
    ========================================= */

    .history-list {
      margin-top: 17px;
      display: grid;
      gap: 10px;
    }

    .history-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(157, 174, 255, 0.08);
      border-radius: 13px;
    }

    .history-name {
      font-size: 13px;
      font-weight: 800;
    }

    .history-date {
      font-size: 11px;
      color: var(--muted);
      margin-top: 5px;
    }

    .history-status {
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .empty-state {
      padding: 30px 15px;
      color: var(--muted);
      border: 1px dashed rgba(157, 174, 255, 0.2);
      border-radius: 15px;
      text-align: center;
      font-size: 13px;
      line-height: 1.8;
    }

    /* =========================================
       11. TELA DO TREINO E CRONÔMETRO
    ========================================= */

    .session-shell {
      max-width: 800px;
      margin: 0 auto;
    }

    .session-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 20px;
    }

    .session-heading h2 {
      margin: 8px 0;
      font-size: clamp(24px, 4vw, 34px);
      letter-spacing: -1px;
    }

    .progress-track {
      height: 6px;
      overflow: hidden;
      border-radius: 99px;
      background: #252d58;
      margin: 17px 0;
    }

    .progress-fill {
      width: 0%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #5375ff, #a06cff);
      transition: width 0.3s ease;
    }

    .session-card {
      padding: clamp(22px, 4vw, 35px);
      border-radius: 25px;
      border: 1px solid rgba(145, 163, 255, 0.22);
      background:
        radial-gradient(
          circle at 100% 0%,
          rgba(104, 73, 255, 0.22),
          transparent 34%
        ),
        linear-gradient(145deg, #182354, #121733);
      box-shadow: 0 25px 65px rgba(0, 0, 0, 0.15);
    }

    .session-card h3 {
      font-size: clamp(23px, 4vw, 32px);
      line-height: 1.2;
      letter-spacing: -0.9px;
      margin: 12px 0;
    }

    .session-goal {
      color: #aabbff;
      font-size: clamp(30px, 5vw, 43px);
      font-weight: 950;
      letter-spacing: -1.3px;
      margin: 20px 0 4px;
    }

    .session-goal-caption {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .session-instructions {
      padding: 17px;
      margin: 23px 0;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.04);
      color: #d6ddfb;
      font-size: 13px;
      line-height: 1.85;
    }

    .session-footer {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .session-footer .btn-primary {
      flex: 1;
    }

    .set-indicator {
      display: flex;
      gap: 8px;
      margin-top: 18px;
    }

    .set-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: rgba(150, 165, 255, 0.2);
    }

    .set-dot.done {
      background: var(--green);
    }

    .set-dot.current {
      background: var(--blue-light);
      box-shadow: 0 0 13px rgba(104, 130, 255, 0.65);
    }

    .timer-wrap {
      text-align: center;
      padding: 30px 15px;
    }

    .timer-number {
      font-size: clamp(64px, 14vw, 92px);
      font-weight: 950;
      letter-spacing: -4px;
      font-variant-numeric: tabular-nums;
      margin: 22px 0;
      background: linear-gradient(110deg, #ffffff, #a5b6ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .timer-caption {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    /* =========================================
       12. FINALIZAÇÃO E NOTIFICAÇÃO
    ========================================= */

    .complete-card {
      max-width: 640px;
      margin: 35px auto;
      padding: clamp(25px, 5vw, 45px);
      text-align: center;
      border-radius: 27px;
      border: 1px solid rgba(108, 230, 176, 0.2);
      background: linear-gradient(
        145deg,
        rgba(24, 65, 72, 0.44),
        #121735
      );
    }

    .complete-symbol {
      width: 80px;
      height: 80px;
      border-radius: 25px;
      display: grid;
      place-items: center;
      margin: 0 auto 22px;
      font-size: 35px;
      color: #c3ffe3;
      background: rgba(108, 230, 176, 0.13);
    }

    .complete-card h2 {
      font-size: 30px;
      margin: 0 0 10px;
    }

    .complete-card p {
      color: #becbe5;
      font-size: 13px;
      line-height: 1.8;
    }

    .complete-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 25px;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      z-index: 100;
      transform: translate(-50%, 20px);
      opacity: 0;
      pointer-events: none;
      max-width: calc(100% - 30px);
      padding: 14px 18px;
      border-radius: 13px;
      background: #e5eaff;
      color: #101735;
      font-size: 12px;
      font-weight: 800;
      text-align: center;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
      transition: 0.2s ease;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    .footer-note {
      color: #747fa9;
      font-size: 10px;
      line-height: 1.8;
      margin-top: 35px;
      text-align: center;
    }

    /* =========================================
       13. RESPONSIVIDADE
    ========================================= */

    @media (max-width: 1050px) {
      .app-shell {
        grid-template-columns: 190px minmax(0, 1fr);
      }

      .workout-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .hero-symbol {
        right: 3%;
      }
    }

    @media (max-width: 760px) {
      .app-shell {
