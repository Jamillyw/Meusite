    const STORAGE = {
      settings: "evoFitnessSettings_v1",
      history: "evoFitnessHistory_v1"
    };

    const DEFAULT_SETTINGS = {
      repBoost: 0,
      restSeconds: 75
    };

    const ALLOWED_REST = [60, 65, 70, 75, 80, 90, 120];

    /* =========================================
       2. ESTADO E LOCALSTORAGE
    ========================================= */

    function readStorage(key, fallback) {
      try {
        const value = localStorage.getItem(key);
        return value === null ? fallback : JSON.parse(value);
      } catch (error) {
        return fallback;
      }
    }

    function writeStorage(key, value) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
        return true;
      } catch (error) {
        showToast(
          "Não foi possível salvar. Confira o armazenamento do navegador."
        );
        return false;
      }
    }

    function loadSettings() {
      const saved = readStorage(STORAGE.settings, {});
      const rest = Number(saved.restSeconds);
      const boost = Number(saved.repBoost);

      return {
        repBoost: [0, 1, 2].includes(boost) ? boost : 0,
        restSeconds: ALLOWED_REST.includes(rest) ? rest : 75
      };
    }

    function loadHistory() {
      const saved = readStorage(STORAGE.history, []);

      if (!Array.isArray(saved)) {
        return [];
      }

      return saved
        .filter(item =>
          item &&
          typeof item.date === "string" &&
          typeof item.name === "string" &&
          typeof item.workoutId === "string"
        )
        .slice(0, 200);
    }

    let settings = loadSettings();
    let history = loadHistory();

    let currentView = "overview";
    let activeSession = null;
    let timerInterval = null;
    let toastTimeout = null;

    const $ = selector => document.querySelector(selector);

    /* =========================================
       3. UTILIDADES
    ========================================= */

    function findWorkout(id) {
      return workouts.find(workout => workout.id === id);
    }

    function getGoal(exercise) {
      if (exercise.unit === "seconds") {
        return exercise.reps;
      }

      return exercise.reps + settings.repBoost;
    }

    function getGoalLabel(exercise) {
      const amount = getGoal(exercise);

      if (exercise.unit === "seconds") {
        return amount + " segundos";
      }

      return amount + (exercise.perSide ? " por lado" : " repetições");
    }

    function formatTime(seconds) {
      const safeSeconds = Math.max(0, Math.floor(seconds));
      const minutes = Math.floor(safeSeconds / 60);
      const remaining = safeSeconds % 60;

      return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(remaining).padStart(2, "0")
      );
    }

    function formatDate(dateString) {
      return new Date(dateString).toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "short",
        year: "numeric"
      });
    }

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, character => {
        const entities = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        };

        return entities[character];
      });
    }

    function showToast(message) {
      const toast = $("#toast");
      toast.textContent = message;
      toast.classList.add("show");

      clearTimeout(toastTimeout);

      toastTimeout = setTimeout(() => {
        toast.classList.remove("show");
      }, 2600);
    }

    /* =========================================
       4. NAVEGAÇÃO
    ========================================= */

    const viewInfo = {
      overview: {
        title: "Treinos & Evolução",
        subtitle: "Um treino de cada vez."
      },

      workouts: {
        title: "Suas fichas",
        subtitle: "Escolha a sessão que vai fazer hoje."
      },

      evolution: {
        title: "Sua evolução",
        subtitle: "Acompanhe os treinos e personalize seu ritmo."
      },

      session: {
        title: "Treino em andamento",
        subtitle: "Faça cada repetição com controle."
